# Conexão PostgreSQL. Local: use o docker-compose.yml (docker compose up -d).
# Produção: Neon, Supabase, Railway, RDS... (use a URL com sslmode=require quando exigido).
DATABASE_URL=postgres://festdecor:festdecor@localhost:5432/festdecor

# Use "false" com poolers em modo transação (ex.: PgBouncer/Supabase porta 6543).
# DATABASE_PREPARE=false
# DATABASE_POOL_MAX=5

# URL pública do site (SEO, sitemap e Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Valores iniciais de contato (podem ser alterados no painel em /admin/configuracoes).
# WhatsApp apenas com números, com DDI e DDD: 5531999999999
SEED_WHATSAPP=
